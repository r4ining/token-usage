# MySQL database connection (pointing to the new-api database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=new-api
DB_TABLE_NAME=logs

# Optional: standalone DSN for the `logs` table.
# When set, the logs table is read from this database (e.g. PostgreSQL)
# instead of the MySQL database above. Other tables (e.g. `tokens`) still
# use the MySQL connection.
# Example (PostgreSQL):
# LOG_SQL_DSN=postgresql://postgres:password@host:5432/newapi
LOG_SQL_DSN=

# Service port (default: 8080)
PORT=8080

# Directory for storing price configuration (mapped as a volume)
DATA_DIR=/data
